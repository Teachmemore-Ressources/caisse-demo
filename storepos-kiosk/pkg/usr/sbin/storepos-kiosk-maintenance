#!/bin/bash
#
# storepos-kiosk-maintenance : arrête / relance l'application de caisse pour une intervention.
# Usage : sudo storepos-kiosk-maintenance on|off|status
#   on     arrête l'application (systemd ne la relance pas après un arrêt manuel)
#   off    relance l'application
#   status état du service

if [ "$(id -u)" -ne 0 ]; then
    echo "Exécuter avec sudo." >&2
    exit 1
fi

case "${1:-}" in
    on)
        systemctl stop storepos.service
        echo "Maintenance : application arrêtée. Le service redémarrera au prochain boot, ou avec 'off'."
        ;;
    off)
        systemctl start storepos.service
        echo "Application relancée."
        ;;
    status)
        systemctl status storepos.service --no-pager
        ;;
    *)
        echo "Usage : $0 on|off|status" >&2
        exit 1
        ;;
esac
