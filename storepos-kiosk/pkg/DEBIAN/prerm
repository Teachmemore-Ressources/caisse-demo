#!/bin/sh
# prerm script for storepos-kiosk
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Arrêter le service AVANT que les fichiers soient retirés
        systemctl stop storepos.service 2>/dev/null || true
        if [ "$1" = "remove" ]; then
            systemctl disable storepos.service 2>/dev/null || true
        fi
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

exit 0
