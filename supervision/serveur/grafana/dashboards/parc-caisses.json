            "displayName": "En attente",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "plateforme": true
            },
            "renameByName": {
              "enseigne": "Enseigne",
              "magasin": "Magasin",
              "poste": "Poste",
              "machine": "Machine"
            }
          }
        }
      ]
