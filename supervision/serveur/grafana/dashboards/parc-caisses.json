    {
      "id": 17,
      "type": "state-timeline",
      "title": "Services (vert = actif)",
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "node_systemd_unit_state{state=\"active\", machine=~\"$machine\"}",
          "legendFormat": "{{machine}} · {{name}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "arrêté",
