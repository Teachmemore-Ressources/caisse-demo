                },
                "1": {
                  "text": "actif",
                  "color": "green"
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 70
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "legend": {
          "showLegend": false
