# Copier en « .env » puis compléter. Ne JAMAIS publier ni sauvegarder ce fichier en clair hors du serveur.
# Droits conseillés :  chmod 600 .env

# --- Passerelle (Caddy) ---
ACME_EMAIL=admin@exemple.fr                  # reçoit les avis d'expiration Let's Encrypt
METRICS_DOMAIN=metrics.exemple.fr            # nom DNS -> adresse IP du serveur (mesures)
LOGS_DOMAIN=logs.exemple.fr                  # nom DNS -> adresse IP du serveur (journaux)

# --- Grafana ---
GRAFANA_DOMAIN=grafana.exemple.fr            # inutile en mode privé
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangezMoi-Mot-de-passe-long    # 16 caractères minimum

# --- Connexion SSO de Grafana (seulement avec docker-compose.sso.yml) ---
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_DOMAINES=exemple.fr                      # seuls ces domaines d'e-mail peuvent se connecter (séparés par des virgules)

# Les identifiants des caisses ne sont PAS ici : un par enseigne, avec scripts/enseigne-ajouter.sh

# --- Inventaire GLPI (seulement avec docker-compose.glpi.yml) ---
GLPI_DOMAIN=glpi.exemple.fr                  # nom DNS -> adresse IP du serveur (envoi d'inventaire par les caisses)
GLPI_DB_PASSWORD=ChangezMoi-Base-GLPI-long   # mot de passe de la base de GLPI
GLPI_DB_ROOT_PASSWORD=ChangezMoi-Root-long   # mot de passe root de la base (sauvegardes, scripts/glpi-initialiser.sh)
GLPI_ADMIN_PASSWORD=                         # compte « glpi » (12 caractères minimum, lettres et chiffres) ; vide = généré par glpi-initialiser.sh
