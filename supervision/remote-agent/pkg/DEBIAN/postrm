#!/bin/sh
# postrm de storepos-kiosk-remote
set -e
case "$1" in
    remove|purge)
        # Retire l'accès à distance : plus de service, plus de configuration ni de mot de passe sur la caisse
        if [ -d /run/systemd/system ]; then
            systemctl stop rustdesk.service >/dev/null 2>&1 || true
            systemctl disable rustdesk.service >/dev/null 2>&1 || true
        fi
        rm -f /root/.config/rustdesk/RustDesk2.toml /var/lib/storepos-kiosk/remote-id
    ;;
esac
exit 0
