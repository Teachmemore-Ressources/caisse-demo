#!/bin/bash
#
# storepos-kiosk-monitoring-enroll : inscrit cette caisse dans la supervision (écrit les réglages de l'agent).
#
# Usage :
#   sudo storepos-kiosk-monitoring-enroll --enseigne LECLERC --magasin LYON-01 --poste 2 \
#        --metrics-url https://metrics.exemple.fr/api/v1/write --logs-url https://logs.exemple.fr/loki/api/v1/push \
#        --user agent-lyon --password '...'
#   (--metrics-user/--metrics-password et --logs-user/--logs-password si les identifiants diffèrent)
#   Derrière un tunnel Cloudflare protégé par un jeton de service : ajouter --cf-access-id ID --cf-access-secret SECRET
#
# À lancer APRÈS la restauration d'une image « ghost », jamais avant : chaque caisse doit avoir son propre
# identifiant machine (vider /etc/machine-id avant de capturer l'image).

set -euo pipefail
# STOREPOS_TEST=1 (tests automatiques uniquement) : autorise un autre fichier et un autre utilisateur que root
CONF="${STOREPOS_MONITORING_CONF:-/etc/default/storepos-kiosk-monitoring}"
MACHINE_ID_FILE="${STOREPOS_MACHINE_ID_FILE:-/etc/machine-id}"

if [ "${STOREPOS_TEST:-0}" != "1" ] && [ "$(id -u)" -ne 0 ]; then echo "Exécuter avec sudo." >&2; exit 1; fi
[ -f "$CONF" ] || { echo "Fichier $CONF introuvable (paquet storepos-kiosk-monitoring installé ?)." >&2; exit 1; }

# valeurs actuelles
set +u
# shellcheck disable=SC1090
. "$CONF"
set -u
M_URL="${METRICS_URL:-}"; M_USER="${METRICS_USER:-}"; M_PASS="${METRICS_PASSWORD:-}"
L_URL="${LOGS_URL:-}"; L_USER="${LOGS_USER:-}"; L_PASS="${LOGS_PASSWORD:-}"
CF_ID="${CF_ACCESS_ID:-}"; CF_SECRET="${CF_ACCESS_SECRET:-}"
ENS="${ENSEIGNE:-demo}"; MAG="${MAGASIN:-non-defini}"; POS="${POSTE:-1}"; MID="${MACHINE_ID:-}"
SET_LOGS_USER=0; SET_LOGS_PASS=0

while [ $# -gt 0 ]; do
    case "$1" in
        --enseigne) ENS="$2"; shift 2 ;;
        --magasin) MAG="$2"; shift 2 ;;
        --poste) POS="$2"; shift 2 ;;
        --metrics-url) M_URL="$2"; shift 2 ;;
        --logs-url) L_URL="$2"; shift 2 ;;
        --user) M_USER="$2"; [ "$SET_LOGS_USER" -eq 0 ] && L_USER="$2"; shift 2 ;;
        --password) M_PASS="$2"; [ "$SET_LOGS_PASS" -eq 0 ] && L_PASS="$2"; shift 2 ;;
        --metrics-user) M_USER="$2"; shift 2 ;;
        --metrics-password) M_PASS="$2"; shift 2 ;;
        --logs-user) L_USER="$2"; SET_LOGS_USER=1; shift 2 ;;
        --logs-password) L_PASS="$2"; SET_LOGS_PASS=1; shift 2 ;;
        --cf-access-id) CF_ID="$2"; shift 2 ;;
        --cf-access-secret) CF_SECRET="$2"; shift 2 ;;
        --machine-id) MID="$2"; shift 2 ;;
        -h|--help) sed -n '3,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Argument inconnu : $1 (voir --help)" >&2; exit 1 ;;
    esac
done

# étiquettes : caractères simples seulement (elles deviennent des étiquettes Prometheus et Loki)
for v in "$ENS" "$MAG" "$POS"; do
    case "$v" in *[!A-Za-z0-9._-]*|'') echo "Valeur d'étiquette invalide : '$v' (lettres, chiffres, . _ - uniquement)" >&2; exit 1 ;; esac
done
case "$M_URL" in https://*|http://localhost*|http://127.0.0.1*) ;; *) echo "METRICS_URL doit être en https:// (reçu : '$M_URL')" >&2; exit 1 ;; esac
case "$L_URL" in https://*|http://localhost*|http://127.0.0.1*|'') ;; *) echo "LOGS_URL doit être en https:// (reçu : '$L_URL')" >&2; exit 1 ;; esac
# une valeur ne doit pas casser le fichier d'environnement
[ -n "$CF_ID" ] && [ -z "$CF_SECRET" ] && { echo "--cf-access-id sans --cf-access-secret : renseigner les deux." >&2; exit 1; }
[ -z "$CF_ID" ] && [ -n "$CF_SECRET" ] && { echo "--cf-access-secret sans --cf-access-id : renseigner les deux." >&2; exit 1; }
for v in "$M_USER" "$M_PASS" "$L_USER" "$L_PASS" "$CF_ID" "$CF_SECRET"; do
    case "$v" in *\'*|*\"*|*$'\n'*|*\\*) echo "Les identifiants ne doivent pas contenir de quote, antislash ni saut de ligne." >&2; exit 1 ;; esac
done

[ -n "$MID" ] || MID=$(tr -d '\n' < "$MACHINE_ID_FILE" 2>/dev/null | cut -c1-12)
[ -n "$MID" ] || { echo "Impossible de déterminer l'identifiant machine ($MACHINE_ID_FILE vide)." >&2; exit 1; }
case "$MID" in *[!A-Za-z0-9._-]*) echo "Identifiant machine invalide : '$MID'" >&2; exit 1 ;; esac

umask 027
TMP=$(mktemp "$CONF.XXXXXX")
cat > "$TMP" <<EOF
# Supervision de la caisse : réglages écrits par storepos-kiosk-monitoring-enroll le $(date '+%Y-%m-%d %H:%M')
METRICS_URL=$M_URL
METRICS_USER=$M_USER
METRICS_PASSWORD=$M_PASS
LOGS_URL=$L_URL
LOGS_USER=$L_USER
LOGS_PASSWORD=$L_PASS
CF_ACCESS_ID=$CF_ID
CF_ACCESS_SECRET=$CF_SECRET
ENSEIGNE=$ENS
MAGASIN=$MAG
POSTE=$POS
MACHINE_ID=$MID
EOF
chown root:alloy "$TMP" 2>/dev/null || chown root:root "$TMP" 2>/dev/null || true
chmod 0640 "$TMP"
mv -f "$TMP" "$CONF"

echo "Caisse inscrite : enseigne=$ENS magasin=$MAG poste=$POS machine=$MID"
[ "${STOREPOS_TEST:-0}" = "1" ] && exit 0
if systemctl is-enabled storepos-kiosk-alloy.service >/dev/null 2>&1 || [ -x /usr/bin/alloy ]; then
    systemctl enable --now storepos-kiosk-alloy.service >/dev/null 2>&1 || true
    systemctl restart storepos-kiosk-alloy.service || true
    echo "Agent redémarré. Contrôle : sudo storepos-kiosk-monitoring-check"
else
    echo "Grafana Alloy n'est pas installé (/usr/bin/alloy). Voir : sudo storepos-kiosk-monitoring-check" >&2
fi
