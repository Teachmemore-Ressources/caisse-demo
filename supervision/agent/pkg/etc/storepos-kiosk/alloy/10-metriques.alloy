// Supervision de la caisse : les mesures partent EN SORTIE vers Prometheus / Mimir / Grafana Cloud
// (remote_write). Aucun port n'est ouvert sur la caisse, rien n'est « scrapé » depuis l'extérieur.
// Les réglages (adresse, identifiants, étiquettes) sont dans /etc/default/storepos-kiosk-monitoring.

logging {
  level  = "warn"
  format = "logfmt"
}

prometheus.remote_write "serveur" {
  endpoint {
    url = sys.env("METRICS_URL")

    basic_auth {
      username = sys.env("METRICS_USER")
      password = sys.env("METRICS_PASSWORD")
    }

    // Cloudflare Access (facultatif) : jeton de service qui prouve que cet envoi vient d'une caisse autorisée.
    // Vide = en-têtes inoffensifs ignorés ; renseigné par storepos-kiosk-monitoring-enroll --cf-access-id/--cf-access-secret.
    headers = {
      "CF-Access-Client-Id"     = sys.env("CF_ACCESS_ID"),
      "CF-Access-Client-Secret" = sys.env("CF_ACCESS_SECRET"),
    }

    // En cas de coupure réseau, remote_write garde les mesures sur disque (WAL, quelques heures) et les rejoue.
    queue_config {
      max_shards = 2
      capacity   = 2500
    }
  }

  // Étiquettes ajoutées à TOUTES les séries : c'est ce qui permet de filtrer par enseigne, magasin ou caisse.
  external_labels = {
    enseigne = sys.env("ENSEIGNE"),
    magasin  = sys.env("MAGASIN"),
    poste    = sys.env("POSTE"),
    machine  = sys.env("MACHINE_ID"),
  }
}

// Mesures du système (processeur, mémoire, disque, réseau, services systemd) + fichiers « textfile » :
//  - caisse.prom : écrit par l'application de caisse (tickets en attente, version, ventes du jour…)
//  - kiosk.prom  : écrit par le script storepos-kiosk-metrics (versions des paquets, périphériques USB…)
prometheus.exporter.unix "caisse" {
  // Santé seulement : processeur, charge, mémoire, disque système, services, température, version. Pas de trafic réseau ni de statistiques
  // par disque (diskstats, netdev, stat, thermal_zone retirés) : elles pèsent lourd à 6000 caisses et ne disent rien de l'état de santé.
  set_collectors = ["cpu", "filesystem", "loadavg", "meminfo", "uname", "time", "uptime", "os", "systemd", "textfile", "hwmon"]

  textfile {
    directory = "/var/lib/storepos-kiosk/metrics"
  }

  systemd {
    unit_include = "(storepos|lightdm|ssh|sshd|teamviewerd|rustdesk|glpi-agent|storepos-kiosk-alloy)\\.service"
  }

  filesystem {
    fs_types_exclude = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs|tmpfs)$"
  }
}

prometheus.scrape "caisse" {
  job_name        = "caisse"
  targets         = prometheus.exporter.unix.caisse.targets
  forward_to      = [prometheus.relabel.reduire.receiver]
  scrape_interval = "60s"
  scrape_timeout  = "30s"
}

// À 6000 caisses, chaque série compte : on retire ce qui ne sert à rien.
prometheus.relabel "reduire" {
  forward_to = [prometheus.remote_write.serveur.receiver]

  // Les cibles de l'exporteur portent déjà un job (« integrations/unix ») qui l'emporte sur job_name :
  // on impose « caisse », sur lequel reposent le tableau de bord et les alertes.
  rule {
    target_label = "job"
    replacement  = "caisse"
  }

  // LISTE BLANCHE : seules ces métriques de santé partent. Tout le reste est écarté, y compris l'activité commerciale (tickets et ventes
  // du jour, catalogue, session du caissier) : ce sont des données de vos clients, pas des indicateurs de santé. Une métrique ajoutée plus
  // tard ne part pas tant qu'on ne l'ajoute pas ICI (le volume reste maîtrisé).
  rule {
    source_labels = ["__name__"]
    regex         = "up|node_cpu_seconds_total|node_load1|node_load5|node_load15|node_memory_(MemTotal|MemAvailable|SwapTotal|SwapFree)_bytes|node_filesystem_(avail|size)_bytes|node_boot_time_seconds|node_time_seconds|node_systemd_unit_state|node_hwmon_temp_celsius|node_uname_info|node_os_info|node_textfile_scrape_error|caisse_(app_info|app_last_write_timestamp_seconds|app_start_time_seconds|tickets_pending|sync_state|last_sync_timestamp_seconds|db_size_bytes)|kiosk_.*"
    action        = "keep"
  }

  // Processeur : « idle » (taux d'utilisation) et « iowait » (disque qui peine) suffisent ; les 6 autres modes sont écartés.
  rule {
    source_labels = ["__name__", "mode"]
    regex         = "node_cpu_seconds_total;(user|system|nice|irq|softirq|steal)"
    action        = "drop"
  }

  // Disque : la partition système « / » seulement (une série par point de montage et par mesure).
  rule {
    source_labels = ["__name__", "mountpoint"]
    regex         = "node_filesystem_.*;/.+"
    action        = "drop"
  }

  // Services : l'état « actif » suffit (une alerte se déclenche quand il vaut 0).
  rule {
    source_labels = ["__name__", "state"]
    regex         = "node_systemd_unit_state;(activating|deactivating|failed|inactive)"
    action        = "drop"
  }
}
